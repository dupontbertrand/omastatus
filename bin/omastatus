#!/usr/bin/env python3
"""Local-first configuration and health-check engine for Omastatus."""

from __future__ import annotations

import argparse
import concurrent.futures
import contextlib
import fcntl
import json
import math
import os
import re
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Iterator
from pathlib import Path
from typing import Any

VERSION = 1
SERVICE_TYPES = {"auto", "http", "tcp", "ping", "systemd"}
VIEW_MODES = {"grouped", "compact", "grid"}
DATABASE_PORTS = {
    "postgres": 5432,
    "postgresql": 5432,
    "mysql": 3306,
    "mariadb": 3306,
    "redis": 6379,
    "mongodb": 27017,
}
UNIT_RE = re.compile(r"^[A-Za-z0-9_.@:-]+$")


def config_dir() -> Path:
    return Path(os.environ.get("OMASTATUS_CONFIG_DIR", Path.home() / ".config/omastatus"))


def state_dir() -> Path:
    return Path(os.environ.get("OMASTATUS_STATE_DIR", Path.home() / ".local/state/omastatus"))


def config_path() -> Path:
    return config_dir() / "config.json"


def state_path() -> Path:
    return state_dir() / "status.json"


def default_config() -> dict[str, Any]:
    return {
        "version": VERSION,
        "settings": {
            "intervalSeconds": 30,
            "timeoutSeconds": 4,
            "failureThreshold": 1,
            "notifications": True,
            "viewMode": "grouped",
        },
        "categories": [],
        "services": [],
    }


def ensure_private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    with contextlib.suppress(OSError):
        path.chmod(0o700)


@contextlib.contextmanager
def locked() -> Iterator[None]:
    ensure_private_dir(config_dir())
    lock_path = config_dir() / ".lock"
    with lock_path.open("a+", encoding="utf-8") as handle:
        with contextlib.suppress(OSError):
            os.chmod(lock_path, 0o600)
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def atomic_write_json(path: Path, payload: dict[str, Any]) -> None:
    ensure_private_dir(path.parent)
    descriptor, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temp_name)


def read_json(path: Path) -> dict[str, Any]:
    try:
        with path.open(encoding="utf-8") as handle:
            value = json.load(handle)
    except FileNotFoundError:
        raise
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"Cannot read {path}: {error}") from error
    if not isinstance(value, dict):
        raise TypeError(f"{path} must contain a JSON object")
    return value


def bounded_int(value: Any, default: int, minimum: int, maximum: int) -> int:
    try:
        number = int(value)
    except (TypeError, ValueError):
        number = default
    return max(minimum, min(maximum, number))


def clean_text(value: Any, label: str, maximum: int) -> str:
    text = str(value or "").strip()
    if not text:
        raise ValueError(f"{label} cannot be empty")
    if len(text) > maximum:
        raise ValueError(f"{label} is limited to {maximum} characters")
    if any(ord(character) < 32 for character in text):
        raise ValueError(f"{label} cannot contain control characters")
    return text


def slug(value: str) -> str:
    normalized = re.sub(r"[^a-z0-9]+", "-", value.casefold()).strip("-")
    return normalized[:48] or "item"


def unique_id(value: str, existing: set[str]) -> str:
    base = slug(value)
    candidate = base
    suffix = 2
    while candidate in existing:
        candidate = f"{base}-{suffix}"
        suffix += 1
    return candidate


def reject_credentials(parsed: urllib.parse.SplitResult) -> None:
    if parsed.username is not None or parsed.password is not None:
        raise ValueError("Credentials are not stored; monitor a host/port without a username or password")


def parse_http(target: str) -> dict[str, Any]:
    parsed = urllib.parse.urlsplit(target)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise ValueError("HTTP targets must be complete http:// or https:// URLs")
    reject_credentials(parsed)
    try:
        _port = parsed.port
    except ValueError as error:
        raise ValueError("The URL contains an invalid port") from error
    return {"kind": "http", "url": target}


def parse_tcp(target: str) -> dict[str, Any]:
    raw = target.strip()
    parsed = urllib.parse.urlsplit(raw if "://" in raw else f"tcp://{raw}")
    scheme = parsed.scheme.casefold()
    if scheme not in {"tcp", *DATABASE_PORTS.keys()}:
        raise ValueError("TCP targets use host:port, tcp://host:port, or a supported database URL")
    reject_credentials(parsed)
    host = parsed.hostname
    if not host:
        raise ValueError("TCP targets need a host")
    try:
        port = parsed.port or DATABASE_PORTS.get(scheme)
    except ValueError as error:
        raise ValueError("The TCP target contains an invalid port") from error
    if not port or port < 1 or port > 65535:
        raise ValueError("TCP targets need a port between 1 and 65535")
    return {"kind": "tcp", "host": host, "port": port}


def parse_ping(target: str) -> dict[str, Any]:
    raw = target.strip()
    if raw.casefold().startswith("ping://"):
        parsed = urllib.parse.urlsplit(raw)
        reject_credentials(parsed)
        host = parsed.hostname
    else:
        host = raw
    if not host or len(host) > 253 or any(character.isspace() for character in host):
        raise ValueError("Ping targets need one hostname or IP address")
    if "/" in host or host.startswith("-"):
        raise ValueError("Ping targets need one hostname or IP address")
    return {"kind": "ping", "host": host}


def parse_systemd(target: str) -> dict[str, Any]:
    raw = target.strip()
    scope = "system"
    unit = raw
    if raw.casefold().startswith("systemd://"):
        parsed = urllib.parse.urlsplit(raw)
        authority = parsed.netloc
        path = parsed.path.lstrip("/")
        if authority in {"user", "system"} and path:
            scope = authority
            unit = path
        elif authority and not path:
            unit = authority
        else:
            raise ValueError("Use systemd://unit.service or systemd://user/unit.service")
    if not UNIT_RE.fullmatch(unit):
        raise ValueError("The systemd unit name is invalid")
    return {"kind": "systemd", "scope": scope, "unit": unit}


def infer_type(target: str) -> str:
    lowered = target.casefold()
    if lowered.startswith(("http://", "https://")):
        return "http"
    if lowered.startswith(("tcp://", *[f"{scheme}://" for scheme in DATABASE_PORTS])):
        return "tcp"
    if lowered.startswith("ping://"):
        return "ping"
    if lowered.startswith("systemd://") or UNIT_RE.fullmatch(target) and target.endswith(".service"):
        return "systemd"
    if re.search(r":\d{1,5}(?:/.*)?$", target):
        return "tcp"
    return "ping"


def parse_probe(service_type: str, target: str) -> dict[str, Any]:
    selected = service_type.casefold()
    if selected not in SERVICE_TYPES:
        raise ValueError(f"Unsupported service type: {service_type}")
    if selected == "auto":
        selected = infer_type(target)
    parser = {
        "http": parse_http,
        "tcp": parse_tcp,
        "ping": parse_ping,
        "systemd": parse_systemd,
    }[selected]
    return parser(target)


def normalize_config(raw: dict[str, Any]) -> dict[str, Any]:
    settings_raw = raw.get("settings") if isinstance(raw.get("settings"), dict) else {}
    view_mode = str(settings_raw.get("viewMode", "grouped"))
    if view_mode not in VIEW_MODES:
        view_mode = "grouped"
    settings = {
        "intervalSeconds": bounded_int(settings_raw.get("intervalSeconds"), 30, 5, 3600),
        "timeoutSeconds": bounded_int(settings_raw.get("timeoutSeconds"), 4, 1, 30),
        "failureThreshold": bounded_int(settings_raw.get("failureThreshold"), 1, 1, 10),
        "notifications": settings_raw.get("notifications", True) is not False,
        "viewMode": view_mode,
    }

    raw_categories = raw.get("categories", [])
    if not isinstance(raw_categories, list):
        raise TypeError("categories must be a JSON array")
    categories: list[dict[str, str]] = []
    category_ids: set[str] = set()
    for index, raw_category in enumerate(raw_categories):
        if not isinstance(raw_category, dict):
            raise TypeError(f"Category {index + 1} must be an object")
        name = clean_text(raw_category.get("name"), "Category name", 60)
        category_id = clean_text(raw_category.get("id") or slug(name), "Category id", 60)
        if category_id in category_ids:
            raise ValueError(f"Duplicate category id: {category_id}")
        category_ids.add(category_id)
        categories.append({"id": category_id, "name": name})

    raw_services = raw.get("services", [])
    if not isinstance(raw_services, list):
        raise TypeError("services must be a JSON array")
    services: list[dict[str, Any]] = []
    service_ids: set[str] = set()
    for index, raw_service in enumerate(raw_services):
        if not isinstance(raw_service, dict):
            raise TypeError(f"Service {index + 1} must be an object")
        name = clean_text(raw_service.get("name"), "Service name", 80)
        target = clean_text(raw_service.get("target"), "Service target", 2048)
        service_type = str(raw_service.get("type", "auto")).casefold()
        probe = parse_probe(service_type, target)
        service_id = clean_text(raw_service.get("id") or slug(name), "Service id", 60)
        if service_id in service_ids:
            raise ValueError(f"Duplicate service id: {service_id}")
        service_ids.add(service_id)
        category_id = str(raw_service.get("categoryId", ""))
        if category_id not in category_ids:
            category_id = ""
        services.append({
            "id": service_id,
            "name": name,
            "target": target,
            "type": probe["kind"],
            "categoryId": category_id,
            "enabled": raw_service.get("enabled", True) is not False,
            "timeoutSeconds": bounded_int(
                raw_service.get("timeoutSeconds"), settings["timeoutSeconds"], 1, 30
            ),
        })

    return {
        "version": VERSION,
        "settings": settings,
        "categories": categories,
        "services": services,
    }


def load_config_unlocked(create: bool = True) -> dict[str, Any]:
    path = config_path()
    if not path.exists():
        if not create:
            raise FileNotFoundError(path)
        config = default_config()
        atomic_write_json(path, config)
        return config
    return normalize_config(read_json(path))


def save_config_unlocked(config: dict[str, Any]) -> dict[str, Any]:
    normalized = normalize_config(config)
    atomic_write_json(config_path(), normalized)
    return normalized


def category_name(config: dict[str, Any], category_id: str) -> str:
    for category in config["categories"]:
        if category["id"] == category_id:
            return category["name"]
    return "Uncategorised"


def base_result(service: dict[str, Any], config: dict[str, Any]) -> dict[str, Any]:
    return {
        "id": service["id"],
        "name": service["name"],
        "target": service["target"],
        "type": service["type"],
        "categoryId": service["categoryId"],
        "categoryName": category_name(config, service["categoryId"]),
        "enabled": service["enabled"],
    }


def timed_result(started: float, ok: bool, message: str, **extra: Any) -> dict[str, Any]:
    return {
        "ok": ok,
        "latencyMs": max(0, round((time.monotonic() - started) * 1000)),
        "message": message,
        **extra,
    }


def check_http(probe: dict[str, Any], timeout: int) -> dict[str, Any]:
    started = time.monotonic()
    request = urllib.request.Request(
        probe["url"], headers={"User-Agent": "Omastatus/0.1"}, method="GET"
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            status = int(response.status)
            response.read(1)
        ok = 200 <= status < 400
        return timed_result(started, ok, f"HTTP {status}", statusCode=status)
    except urllib.error.HTTPError as error:
        status = int(error.code)
        return timed_result(started, False, f"HTTP {status}", statusCode=status)
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        reason = getattr(error, "reason", error)
        return timed_result(started, False, str(reason), statusCode=0)


def check_tcp(probe: dict[str, Any], timeout: int) -> dict[str, Any]:
    started = time.monotonic()
    try:
        with socket.create_connection((probe["host"], probe["port"]), timeout=timeout):
            pass
        return timed_result(started, True, f"TCP {probe['port']} open")
    except (TimeoutError, OSError) as error:
        return timed_result(started, False, str(error))


def check_ping(probe: dict[str, Any], timeout: int) -> dict[str, Any]:
    started = time.monotonic()
    try:
        completed = subprocess.run(
            ["ping", "-n", "-c", "1", "-W", str(max(1, math.ceil(timeout))), probe["host"]],
            capture_output=True,
            text=True,
            timeout=timeout + 1,
            check=False,
        )
    except FileNotFoundError:
        return timed_result(started, False, "ping is not installed")
    except subprocess.TimeoutExpired:
        return timed_result(started, False, "Ping timed out")
    if completed.returncode == 0:
        latency_match = re.search(r"time[=<]([0-9.]+)\s*ms", completed.stdout)
        latency = round(float(latency_match.group(1))) if latency_match else None
        result = timed_result(started, True, "Host reachable")
        if latency is not None:
            result["latencyMs"] = latency
        return result
    detail = completed.stderr.strip() or "Host unreachable"
    return timed_result(started, False, detail.splitlines()[-1])


def check_systemd(probe: dict[str, Any], timeout: int) -> dict[str, Any]:
    started = time.monotonic()
    command = ["systemctl"]
    if probe["scope"] == "user":
        command.append("--user")
    command.extend(["is-active", probe["unit"]])
    try:
        completed = subprocess.run(
            command, capture_output=True, text=True, timeout=timeout, check=False
        )
    except FileNotFoundError:
        return timed_result(started, False, "systemctl is not installed")
    except subprocess.TimeoutExpired:
        return timed_result(started, False, "systemd check timed out")
    state = completed.stdout.strip() or completed.stderr.strip() or "unknown"
    return timed_result(started, completed.returncode == 0 and state == "active", state)


def check_service(service: dict[str, Any], config: dict[str, Any]) -> dict[str, Any]:
    row = base_result(service, config)
    checked_at = int(time.time() * 1000)
    if not service["enabled"]:
        return {**row, "status": "disabled", "latencyMs": 0, "message": "Disabled", "checkedAt": checked_at}
    try:
        probe = parse_probe(service["type"], service["target"])
        checker = {
            "http": check_http,
            "tcp": check_tcp,
            "ping": check_ping,
            "systemd": check_systemd,
        }[probe["kind"]]
        probe_result = checker(probe, service["timeoutSeconds"])
    except (KeyError, OSError, TypeError, ValueError) as error:
        # One invalid probe must not cancel checks for unrelated services.
        probe_result = {"ok": False, "latencyMs": 0, "message": str(error)}
    return {
        **row,
        **{key: value for key, value in probe_result.items() if key != "ok"},
        "rawStatus": "up" if probe_result["ok"] else "down",
        "checkedAt": checked_at,
    }


def load_previous_rows() -> dict[str, dict[str, Any]]:
    try:
        state = read_json(state_path())
    except (FileNotFoundError, ValueError):
        return {}
    rows = state.get("services", [])
    if not isinstance(rows, list):
        return {}
    return {row.get("id"): row for row in rows if isinstance(row, dict) and row.get("id")}


def summarize(rows: list[dict[str, Any]]) -> dict[str, Any]:
    counts = {"total": 0, "up": 0, "down": 0, "degraded": 0, "unknown": 0, "disabled": 0}
    for row in rows:
        status = row.get("status", "unknown")
        if status == "disabled":
            counts["disabled"] += 1
            continue
        counts["total"] += 1
        counts[status if status in counts else "unknown"] += 1
    if counts["down"]:
        overall = "down"
    elif counts["degraded"]:
        overall = "degraded"
    elif counts["total"] and counts["up"] == counts["total"]:
        overall = "up"
    else:
        overall = "unknown"
    counts["overall"] = overall
    return counts


def run_checks(config: dict[str, Any]) -> dict[str, Any]:
    services = config["services"]
    enabled = [service for service in services if service["enabled"]]
    checked: dict[str, dict[str, Any]] = {}
    if enabled:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, len(enabled))) as executor:
            futures = {executor.submit(check_service, service, config): service["id"] for service in enabled}
            for future in concurrent.futures.as_completed(futures):
                checked[futures[future]] = future.result()

    previous = load_previous_rows()
    threshold = config["settings"]["failureThreshold"]
    rows: list[dict[str, Any]] = []
    now = int(time.time() * 1000)
    for service in services:
        if not service["enabled"]:
            rows.append(check_service(service, config))
            continue
        row = checked[service["id"]]
        old = previous.get(service["id"], {})
        failures = 0 if row["rawStatus"] == "up" else int(old.get("consecutiveFailures", 0)) + 1
        row["consecutiveFailures"] = failures
        row["status"] = "up" if row["rawStatus"] == "up" else ("down" if failures >= threshold else "degraded")
        row.pop("rawStatus", None)
        rows.append(row)
    payload = {
        "version": VERSION,
        "checkedAt": now,
        "summary": summarize(rows),
        "services": rows,
    }
    atomic_write_json(state_path(), payload)
    return payload


def cached_state(config: dict[str, Any]) -> dict[str, Any]:
    try:
        cached = read_json(state_path())
    except (FileNotFoundError, ValueError):
        cached = {"services": []}
    cached_rows = cached.get("services", [])
    if not isinstance(cached_rows, list):
        cached_rows = []
    old_rows = {row.get("id"): row for row in cached_rows if isinstance(row, dict) and row.get("id")}
    rows: list[dict[str, Any]] = []
    for service in config["services"]:
        base = base_result(service, config)
        old = old_rows.get(service["id"])
        if old and bool(old.get("enabled")) == service["enabled"]:
            rows.append({**old, **base})
        elif not service["enabled"]:
            rows.append({**base, "status": "disabled", "latencyMs": 0, "message": "Disabled", "checkedAt": 0})
        else:
            rows.append({**base, "status": "unknown", "latencyMs": 0, "message": "Waiting for first check", "checkedAt": 0})
    return {
        "version": VERSION,
        "checkedAt": int(cached.get("checkedAt", 0)),
        "summary": summarize(rows),
        "services": rows,
    }


def print_json(payload: dict[str, Any]) -> None:
    json.dump(payload, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")


def command_init(_args: argparse.Namespace) -> None:
    with locked():
        config = load_config_unlocked(create=True)
    ensure_private_dir(state_dir())
    print_json(config)


def command_config(_args: argparse.Namespace) -> None:
    with locked():
        print_json(load_config_unlocked(create=True))


def command_status(_args: argparse.Namespace) -> None:
    with locked():
        config = load_config_unlocked(create=True)
    print_json(cached_state(config))


def command_check(_args: argparse.Namespace) -> None:
    with locked():
        config = load_config_unlocked(create=True)
    print_json(run_checks(config))


def command_add(args: argparse.Namespace) -> None:
    name = clean_text(args.name, "Service name", 80)
    target = clean_text(args.target, "Service target", 2048)
    probe = parse_probe(args.type, target)
    with locked():
        config = load_config_unlocked(create=True)
        category_ids = {category["id"] for category in config["categories"]}
        category_id = args.category or ""
        if category_id and category_id not in category_ids:
            raise ValueError(f"Unknown category: {category_id}")
        service = {
            "id": unique_id(name, {item["id"] for item in config["services"]}),
            "name": name,
            "target": target,
            "type": probe["kind"],
            "categoryId": category_id,
            "enabled": True,
            "timeoutSeconds": config["settings"]["timeoutSeconds"],
        }
        config["services"].append(service)
        save_config_unlocked(config)
    print_json(service)


def command_remove(args: argparse.Namespace) -> None:
    with locked():
        config = load_config_unlocked(create=True)
        before = len(config["services"])
        config["services"] = [service for service in config["services"] if service["id"] != args.id]
        if len(config["services"]) == before:
            raise ValueError(f"Unknown service: {args.id}")
        save_config_unlocked(config)
    print_json({"removed": args.id})


def command_toggle(args: argparse.Namespace) -> None:
    with locked():
        config = load_config_unlocked(create=True)
        selected = next((service for service in config["services"] if service["id"] == args.id), None)
        if not selected:
            raise ValueError(f"Unknown service: {args.id}")
        selected["enabled"] = not selected["enabled"]
        save_config_unlocked(config)
    print_json(selected)


def command_set_category(args: argparse.Namespace) -> None:
    with locked():
        config = load_config_unlocked(create=True)
        selected = next((service for service in config["services"] if service["id"] == args.id), None)
        if not selected:
            raise ValueError(f"Unknown service: {args.id}")
        category_id = args.category
        if category_id and not any(category["id"] == category_id for category in config["categories"]):
            raise ValueError(f"Unknown category: {category_id}")
        selected["categoryId"] = category_id
        save_config_unlocked(config)
    print_json(selected)


def command_add_category(args: argparse.Namespace) -> None:
    name = clean_text(args.name, "Category name", 60)
    with locked():
        config = load_config_unlocked(create=True)
        if any(category["name"].casefold() == name.casefold() for category in config["categories"]):
            raise ValueError(f"Category already exists: {name}")
        category = {
            "id": unique_id(name, {item["id"] for item in config["categories"]}),
            "name": name,
        }
        config["categories"].append(category)
        save_config_unlocked(config)
    print_json(category)


def command_remove_category(args: argparse.Namespace) -> None:
    with locked():
        config = load_config_unlocked(create=True)
        before = len(config["categories"])
        config["categories"] = [category for category in config["categories"] if category["id"] != args.id]
        if len(config["categories"]) == before:
            raise ValueError(f"Unknown category: {args.id}")
        for service in config["services"]:
            if service["categoryId"] == args.id:
                service["categoryId"] = ""
        save_config_unlocked(config)
    print_json({"removed": args.id})


def command_set_view(args: argparse.Namespace) -> None:
    with locked():
        config = load_config_unlocked(create=True)
        config["settings"]["viewMode"] = args.mode
        save_config_unlocked(config)
    print_json({"viewMode": args.mode})


def command_set_interval(args: argparse.Namespace) -> None:
    interval = bounded_int(args.seconds, 30, 5, 3600)
    with locked():
        config = load_config_unlocked(create=True)
        config["settings"]["intervalSeconds"] = interval
        save_config_unlocked(config)
    print_json({"intervalSeconds": interval})


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="omastatus", description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("init", help="Create the private default configuration").set_defaults(func=command_init)
    subparsers.add_parser("config", help="Print normalized configuration").set_defaults(func=command_config)
    subparsers.add_parser("status", help="Print the latest cached status").set_defaults(func=command_status)
    subparsers.add_parser("check", help="Check every enabled service now").set_defaults(func=command_check)

    add_parser = subparsers.add_parser("add", help="Add a monitored service")
    add_parser.add_argument("--name", required=True)
    add_parser.add_argument("--target", required=True)
    add_parser.add_argument("--type", choices=sorted(SERVICE_TYPES), default="auto")
    add_parser.add_argument("--category", default="")
    add_parser.set_defaults(func=command_add)

    remove_parser = subparsers.add_parser("remove", help="Remove a monitored service")
    remove_parser.add_argument("id")
    remove_parser.set_defaults(func=command_remove)

    toggle_parser = subparsers.add_parser("toggle", help="Enable or disable a monitored service")
    toggle_parser.add_argument("id")
    toggle_parser.set_defaults(func=command_toggle)

    set_category_parser = subparsers.add_parser("set-category", help="Assign a service to a category")
    set_category_parser.add_argument("id")
    set_category_parser.add_argument("category", nargs="?", default="")
    set_category_parser.set_defaults(func=command_set_category)

    category_parser = subparsers.add_parser("add-category", help="Add a category")
    category_parser.add_argument("name")
    category_parser.set_defaults(func=command_add_category)

    remove_category_parser = subparsers.add_parser("remove-category", help="Remove a category")
    remove_category_parser.add_argument("id")
    remove_category_parser.set_defaults(func=command_remove_category)

    view_parser = subparsers.add_parser("set-view", help="Choose the panel layout")
    view_parser.add_argument("mode", choices=sorted(VIEW_MODES))
    view_parser.set_defaults(func=command_set_view)

    interval_parser = subparsers.add_parser("set-interval", help="Set the polling interval")
    interval_parser.add_argument("seconds", type=int)
    interval_parser.set_defaults(func=command_set_interval)
    return parser


def main() -> int:
    try:
        args = build_parser().parse_args()
        args.func(args)
        return 0
    except (TypeError, ValueError, OSError) as error:
        print(f"omastatus: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
